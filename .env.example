# --- GrantIQ MCP env -------------------------------------------------------

# SAM.gov API key (apply at https://sam.gov for your own).
SAM_API_KEY=SAM-4b2f823c-bfd2-4555-bafb-b527e9e48058

# Where to keep the SQLite cache + key store. On Railway, point this at a
# mounted Volume so cache + keys survive deploys.
GRANTIQ_DB_PATH=/data/grantiq.db

# Required to mint API keys via /admin/keys and to flip pro tier via /billing/upgrade.
GRANTIQ_ADMIN_TOKEN=replace-with-strong-random

# Optional — bypass X-API-Key for local dev only. Leave UNSET in prod.
# GRANTIQ_BYPASS_KEY=grantiq-dev-key-001

PORT=8000
LOG_LEVEL=INFO
